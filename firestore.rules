rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null && request.auth.token.email != null; }
    function emp() { return get(/databases/$(database)/documents/employees/$(request.auth.token.email.split('@')[0])).data; }
    // Genel yönetici: yönetici ve mağazası YOK. Mağaza yöneticisi: yönetici ve mağazası VAR (yalnızca kendi mağazasına yazar).
    function isAdmin() { return signed() && emp().get('isAdmin', false) == true && emp().get('magaza', '') == ''; }
    function isStoreAdmin() { return signed() && emp().get('isAdmin', false) == true && emp().get('magaza', '') != ''; }
    function store() { return emp().get('magaza', ''); }

    // Pano herkese açık okunur (ad, saat, durum; telefon YOK). Kilitlemek için: if isAdmin();
    match /attendance/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isStoreAdmin() && request.resource.data.get('magaza', '') == store();
      allow update: if isStoreAdmin() && resource.data.get('magaza', '') == store() && request.resource.data.get('magaza', '') == store();
      allow delete: if isStoreAdmin() && (resource == null || resource.data.get('magaza', '') == store());

      // Çalışan, mesajdaki kişisel bağlantıyla yalnızca kendi kaydını onaylayabilir
      allow update: if resource.data.confirmed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'confirmedAt', 'confirmedBy'])
        && request.resource.data.confirmed == true
        && request.resource.data.confirmedBy == 'calisan'
        && request.resource.data.confirmedAt == request.time
        && existsAfter(/databases/$(database)/documents/confirms/$(id))
        && getAfter(/databases/$(database)/documents/confirms/$(id)).data.ctoken
           == get(/databases/$(database)/documents/employees/$(resource.data.sicil)).data.token;
    }

    // Onay sırasında token'ı taşıyan geçici belge (herkes yazabilir, yalnızca yönetici okur)
    match /confirms/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['ctoken']);
      allow read, delete: if isAdmin();
    }

    match /employees/{sicil} {
      allow read, write: if isAdmin();
      allow read: if isStoreAdmin() && resource.data.magaza == store();
    }

    // Giriş ekranı için: yalnızca {ad} içerir (telefon/token yok). Tek tek okunabilir, listelenemez.
    match /roster/{sicil} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Herkese görünen haftalık vardiya görseli (belge kimliği = haftanın Pazartesi tarihi)
    match /shiftImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow write: if isStoreAdmin() && id.matches(store() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // İzinli günler (herkese görünür; belge kimliği = tarih_sicil)
    match /offdays/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isStoreAdmin() && request.resource.data.get('magaza', '') == store();
      allow update: if isStoreAdmin() && resource.data.get('magaza', '') == store() && request.resource.data.get('magaza', '') == store();
      allow delete: if isStoreAdmin() && (resource == null || resource.data.get('magaza', '') == store());
    }

    // Sıralama ve renk için herkese açık: yalnızca {sicil: {r: rol, s: sıra}} içerir
    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // Ziyaretçi sayacı: herkes yalnızca +1 artırabilir
      allow create, update: if id == 'sayac' && request.resource.data.keys().hasOnly(['toplam']) && request.resource.data.toplam is int
        && (resource == null ? request.resource.data.toplam == 1 : request.resource.data.toplam == resource.data.toplam + 1);
    }

    // Haftalık mesai düzeltmeleri (elle girilen saatler): yönetici ve kendi mağazasının yöneticisi
    match /mesai/{id} {
      allow read, write: if isAdmin();
      allow read: if isStoreAdmin() && resource.data.magaza == store();
      allow create: if isStoreAdmin() && request.resource.data.magaza == store();
      allow update: if isStoreAdmin() && resource.data.magaza == store() && request.resource.data.magaza == store();
      allow delete: if isStoreAdmin() && resource.data.magaza == store();
    }

    // Aylık saat düzeltmeleri (izin/rapor/resmi kapalı gün, elle hedef): yalnızca genel yönetici
    match /aylik/{id} {
      allow read, write: if isAdmin();
    }

    // Çevrimiçi sayacı: cihaz başına tek belge {ms: son nabız zamanı}; kimlik/ad içermez
    match /presence/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['ms']) && request.resource.data.ms is int;
    }

    match /settings/{id} {
      allow read: if isAdmin() || isStoreAdmin();
      allow write: if isAdmin();
    }
  }
}
