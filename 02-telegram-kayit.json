{
  "name": "Telegram Telefon Kaydı",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "name": "Telegram Mesaj",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "webhookId": "bim-takip-kayit",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// >>> BURAYI DÜZENLEYİN <<<\nconst BOT_TOKEN = 'BOTFATHER_TOKEN';   // BotFather'dan aldığınız token\nconst PROJECT = 'PROJE_ID';            // Firebase proje kimliği\nconst m = $json.message || {};\nconst base = { botToken: BOT_TOKEN, project: PROJECT, chatId: String(m.chat?.id || '') };\nif (m.contact) {\n  if (m.contact.user_id && m.from && m.contact.user_id !== m.from.id)\n    return [{ json: { ...base, type: 'other', reply: 'Lütfen yalnızca kendi telefon numaranızı paylaşın.' } }];\n  return [{ json: { ...base, type: 'contact', tel10: String(m.contact.phone_number).replace(/\\D/g, '').slice(-10), firstName: m.contact.first_name || '' } }];\n}\nreturn [{ json: { ...base, type: 'start', reply: 'Merhaba! Giriş/çıkış hatırlatmalarını alabilmek için aşağıdaki butonla telefon numaranızı paylaşın.' } }];"
      },
      "name": "Analiz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "Kontakt-mu?",
              "leftValue": "={{ $json.type }}",
              "rightValue": "contact",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Kontakt mu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Analiz').first().json.botToken }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chatId, text: $json.reply, reply_markup: { keyboard: [[{ text: '📱 Numaramı paylaş', request_contact: true }]], resize_keyboard: true, one_time_keyboard: true } }) }}",
        "options": {}
      },
      "name": "Telefon İste",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://firestore.googleapis.com/v1/projects/{{ $('Analiz').first().json.project }}/databases/(default)/documents:runQuery",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ structuredQuery: { from: [{ collectionId: 'employees' }], limit: 1, where: { fieldFilter: { field: { fieldPath: 'tel10' }, op: 'EQUAL', value: { stringValue: $json.tel10 } } } } }) }}"
      },
      "name": "Çalışanı Bul",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        160
      ],
      "credentials": {
        "googleApi": {
          "id": "",
          "name": "Google Service Account (Firestore)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const a = $('Analiz').first().json;\nconst d = $input.all().map(i => i.json.document).filter(Boolean)[0];\nif (!d) return [{ json: { found: 'no', chatId: a.chatId, botToken: a.botToken, project: a.project } }];\nreturn [{ json: { found: 'yes', sicil: d.name.split('/').pop(), ad: d.fields.ad?.stringValue || '', chatId: a.chatId, botToken: a.botToken, project: a.project } }];"
      },
      "name": "Eşle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "Bulundu-mu?",
              "leftValue": "={{ $json.found }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Bulundu mu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        160
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://firestore.googleapis.com/v1/projects/{{ $('Analiz').first().json.project }}/databases/(default)/documents/employees/{{ $json.sicil }}?updateMask.fieldPaths=telegramChatId",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { telegramChatId: { stringValue: $json.chatId } } }) }}"
      },
      "name": "Chat ID Kaydet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        60
      ],
      "credentials": {
        "googleApi": {
          "id": "",
          "name": "Google Service Account (Firestore)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Analiz').first().json.botToken }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Eşle').first().json.chatId, text: '✅ Teşekkürler ' + $('Eşle').first().json.ad + ', kaydınız tamamlandı. Hatırlatmalar bu sohbete gelecek.', reply_markup: { remove_keyboard: true } }) }}",
        "options": {}
      },
      "name": "Kayıt Tamam",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Analiz').first().json.botToken }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Eşle').first().json.chatId, text: 'Bu numara sistemde kayıtlı değil. Lütfen yöneticinizle iletişime geçin.', reply_markup: { remove_keyboard: true } }) }}",
        "options": {}
      },
      "name": "Numara Yok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        260
      ]
    }
  ],
